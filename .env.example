# Copy to .env and fill in to pull real closed deals + agreements from HubSpot.
# Leave HUBSPOT_MODE unset (or "mock") to keep using fabricated demo data.

# Optional -- leave unset for local dev (falls back to a local SQLite file,
# rally_state.db). Railway sets this automatically once this service is
# linked to its Postgres database; nothing else in this file needs to
# change for that switch to happen.
DATABASE_URL=

HUBSPOT_MODE=mock
HUBSPOT_TOKEN=

# HubSpot Private App scopes needed (Settings -> Integrations -> Private Apps):
#   crm.objects.deals.read
#   crm.objects.companies.read
#   crm.objects.contacts.read
#   crm.objects.notes.read
#   crm.objects.quotes.read
#   files

# Content extraction (run_pipeline.py step 3). Leave LLM_MODE unset (or
# "mock") to use the built-in regex heuristic instead of a real LLM call.
LLM_MODE=live

# Which live client to use. "anthropic" needs a funded Anthropic account;
# "groq" is a free-tier-friendly alternative for testing the real LLM path
# without Anthropic credits — same prompt, different provider.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Only needed when LLM_PROVIDER=groq. Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# QuickBooks Online — reconciliation (payments/invoices). Leave QBO_MODE
# unset (or "mock") until you're ready to test against a real sandbox.
QBO_MODE=live
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
QBO_REALM_ID=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
# Optional: a still-valid access token, if you'd rather skip the refresh
# step for a quick one-off test. Expires in ~1h either way.
QBO_ACCESS_TOKEN=

# Gmail — collections/dunning email delivery. Leave GMAIL_MODE unset (or
# "mock") until you're ready to send for real. Needs a Google Cloud OAuth
# client (Desktop or Web application type) with the gmail.send scope; get
# GMAIL_REFRESH_TOKEN via https://developers.google.com/oauthplayground
# using "your own OAuth credentials".
GMAIL_MODE=live
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Automated reminder batch (POST /api/collections/reminders/run, the "Run
# reminder cycle" button, or `python ar_aging_report.py --send`) -- the
# -7/0/+14-day cadence itself isn't configurable, only where it sends.
# Every reminder email goes here instead of the real customer address, for
# safe testing -- set to "real" to start sending to each invoice's actual
# QuickBooks BillEmail instead.
OUTSTANDING_REMINDER_OVERRIDE_EMAIL=capstnprjt@gmail.com
